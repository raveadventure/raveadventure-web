# dependencies
/node_modules

# lokalne skille Claude Code (npx skills add ...) — narzędzia developerskie,
# nie kod strony, personalne dla środowiska danej maszyny
/.agents/
/.claude/skills/
/skills-lock.json

# next.js build output
/.next/
/out/

# production build
/build

# env files
.env
.env*.local

# lokalny podgląd maili (patrz lib/devEmail.ts)
/.dev-emails/

# lokalny mock tabeli orders (patrz lib/ordersLocalMock.ts / app/api/dev-orders) — zawiera zdjęcia
# jako base64, potrafi urosnąć do kilkunastu MB, nigdy nie commitować
/.dev-orders/
/public/dev-order-photos/

# lokalne zdjęcia kart do portfolio (mock na czas redesignu, patrz lib/portfolioLocalMock.ts)
/public/portfolio-local/

# lokalny mock tabeli portfolio dla panelu admina (patrz lib/devPortfolioStore.ts /
# app/api/dev-portfolio) — zawiera zdjęcia jako base64, potrafi urosnąć, nigdy nie commitować
/.dev-portfolio/

# lokalny licznik odwiedzin (patrz app/api/track-visit) — realne dane liczy prawdziwa tabela
# page_views w Supabase, to tylko do testów lokalnych
/.dev-page-views/

# surowe oryginały zdjęć/wideo prawdziwych kart (setki MB, telefon 4K) — przetworzone,
# skompresowane wersje bez EXIF/GPS leżą bezpośrednio w /public/real-cards/ i te idą do gita
/public/real-cards/_originals/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# os
.DS_Store
Thumbs.db
